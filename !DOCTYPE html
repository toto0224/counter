<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>モンスト EXカウンター風ツール</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            text-align: center;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 10px;
        }
        .container {
            max-width: 450px;
            margin: 20px auto;
            background: #1e1e1e;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            border: 1px solid #333;
        }
        h1 { font-size: 20px; color: #ffca28; margin-bottom: 20px; border-bottom: 2px solid #ffca28; padding-bottom: 5px; }
        
        /* ステータス表示テーブル */
        .status-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            font-size: 16px;
        }
        .status-table td {
            padding: 10px;
            border-bottom: 1px solid #333;
            text-align: left;
        }
        .status-table td.val {
            text-align: right;
            font-weight: bold;
            color: #00e676;
            font-size: 18px;
        }
        .status-table td.highlight { color: #ff5252; }

        /* 操作ボタン */
        .grid-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 15px;
        }
        button {
            font-size: 18px;
            font-weight: bold;
            padding: 15px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            touch-action: manipulation; /* スマホのタップ遅延を完全に防止 */
        }
        .btn-clear { background-color: #00e676; color: #000; }  /* 周回ボタン */
        .btn-encounter { background-color: #ff5252; color: #fff; } /* 遭遇ボタン */
        
        .sub-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .btn-edit { background-color: #555; color: #fff; font-size: 14px; padding: 8px; }
        .btn-reset { background-color: #333; color: #aaa; font-size: 14px; padding: 8px; }
    </style>
</head>
<body>

<div class="container">
    <h1>モンストEXカウンター</h1>
    
    <!-- データを表示するテーブル構造 -->
    <table class="status-table">
        <tr>
            <td>ハマり</td>
            <td id="hamari" class="val highlight">0</td>
        </tr>
        <tr>
            <td>ラック</td>
            <td id="luck" class="val">0</td>
        </tr>
        <tr>
            <td>遭遇数</td>
            <td id="encounter" class="val">0</td>
        </tr>
        <tr>
            <td>遭遇率</td>
            <td id="rate" class="val">0.00%</td>
        </tr>
        <tr>
            <td>総周回数</td>
            <td id="total" class="val">0</td>
        </tr>
    </table>

    <!-- メイン操作ボタン（onclickで確実に動くように設定） -->
    <div class="grid-buttons">
        <button class="btn-clear" onclick="handleClear()">周回 (+1)</button>
        <button class="btn-encounter" onclick="handleEncounter()">遭遇 (リセット)</button>
    </div>

    <!-- サブ操作ボタン -->
    <div class="sub-buttons">
        <button class="btn-edit" onclick="handleEdit()">数値を編集</button>
        <button class="btn-reset" onclick="handleReset()">リreset</button>
    </div>
</div>

<script>
    // ブラウザに自動保存するキー名
    const STORAGE_KEY = 'monst_ex_counter_data';

    // データの初期構造
    let data = {
        hamari: 0,
        luck: 0,
        encounter: 0,
        total: 0
    };

    // ページ読み込み時に保存データを復元
    const savedData = localStorage.getItem(STORAGE_KEY);
    if (savedData) {
        try {
            data = JSON.parse(savedData);
        } catch(e) {
            console.error("データ読み込みエラー", e);
        }
    }

    // 画面の数値を最新の状態に書き換える関数
    function updateDisplay() {
        document.getElementById('hamari').innerText = data.hamari;
        document.getElementById('luck').innerText = data.luck;
        document.getElementById('encounter').innerText = data.encounter;
        document.getElementById('total').innerText = data.total;

        // 遭遇率の計算（総周回数が0の場合は0.00%）
        if (data.total > 0) {
            let rate = (data.encounter / data.total) * 100;
            document.getElementById('rate').innerText = rate.toFixed(2) + '%';
        } else {
            document.getElementById('rate').innerText = '0.00%';
        }
    }

    // データをブラウザに保存する関数
    function saveData() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    }

    // 「周回」ボタンを押したとき
    function handleClear() {
        data.hamari += 1;
        data.total += 1;
        saveData();
        updateDisplay();
    }

    // 「遭遇」ボタンを押したとき
    function handleEncounter() {
        data.encounter += 1;
        data.luck += 1; // 遭遇したらラックも1上がると仮定（編集可能）
        data.hamari = 0; // ハマりはリセット
        saveData();
        updateDisplay();
    }

    // 「数値を編集」ボタン（直接手入力で修正したい時用）
    function handleEdit() {
        let newLuck = prompt("現在のラックを入力してください:", data.luck);
        if (newLuck !== null) {
            data.luck = parseInt(newLuck) || 0;
            saveData();
            updateDisplay();
        }
    }

    // 「リセット」ボタン
    function handleReset() {
        if (confirm("すべてのデータをリセットしますか？")) {
            data = { hamari: 0, luck: 0, encounter: 0, total: 0 };
            saveData();
            updateDisplay();
        }
    }

    // 最初にページを開いた瞬間に画面を更新
    updateDisplay();
</script>

</body>
</html>
